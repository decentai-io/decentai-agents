{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sidra order",
  "type": "object",
  "required": ["id", "placed", "customer", "status", "total", "currency"],
  "properties": {
    "id": {"type": "string", "pattern": "^SO-[0-9]{4}$"},
    "placed": {"type": "string", "format": "date"},
    "customer": {
      "type": "object",
      "required": ["name", "city", "account"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "city": {"type": "string", "minLength": 1},
        "account": {"type": "string"}
      }
    },
    "status": {"type": "string", "enum": ["delivered", "in transit", "awaiting payment", "cancelled"]},
    "total": {"type": "number", "minimum": 0},
    "currency": {"type": "string", "enum": ["USD", "AED"]},
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sku", "qty", "unit_price"],
        "properties": {
          "sku": {"type": "string"},
          "qty": {"type": "integer", "minimum": 1},
          "unit_price": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
